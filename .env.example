# Pixoo Radar settings. Copy to .env and edit. Full reference: docs/configuration.md

# --- Required ---------------------------------------------------------------
# IP or hostname of your Pixoo64 (find it in the Divoom app: Device settings > Wi-Fi)
PIXOO_HOST=192.168.1.50
# Your location in decimal degrees (right-click a spot in Google Maps to copy it)
HOME_LAT=51.4700
HOME_LON=-0.4543

# --- Recommended ------------------------------------------------------------
# Where the Pixoo can fetch animations from this app: plain http, this host's LAN
# IP or name, and the app's own port. Avoids the "Loading.." screen on every update.
# Leave empty to push frames instead.
GIF_BASE_URL=http://192.168.1.20:8765
# Timezone for log timestamps
TZ=Europe/London

# --- Optional (defaults shown; quote colours because of the #) ----------
#RADAR_RADIUS_KM=100
#REFRESH_SECONDS=60
#SHOW_GROUND_TRAFFIC=false
#IGNORE_HELICOPTERS=true
#SKIP_UNKNOWN_DESTINATION=false
#HIGHLIGHT_MILITARY=true
#HIGHLIGHT_RARE=true
#PRIORITIZE_HIGHLIGHTS=true
#RARE_REGISTRATIONS=
#FRAME_MS=300
#SHOW_BEARING=true
#SPLIT_FLAP=off
#PIXOO_BRIGHTNESS=-1
#LOGO_SOURCES=fr24,avcodes
#COLOR_TEXT="#FFFF00"
#COLOR_BOX="#2B2B2B"
#WEB_PORT=8765
#SHOW_HEADING=true
# Data: fr24, adsb (adsb.lol or your receiver's .../data/aircraft.json), opensky; several = fallbacks
#DATA_SOURCE=fr24
#ADSB_URL=https://api.adsb.lol/v2/point/{lat}/{lon}/{radius_nm}
#LOOKUP_ADSBDB=true
#OPENSKY_CLIENT_ID=
#OPENSKY_CLIENT_SECRET=
# History of every aircraft seen: off, sqlite or csv
#HISTORY=off
#HISTORY_RETENTION_DAYS=30
#HISTORY_TRIM_HOURS=1
# MQTT / Home Assistant (off unless MQTT_HOST is set)
#MQTT_HOST=
#MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
#MQTT_TLS=false
#MQTT_TOPIC=pixoo_radar
#MQTT_DISCOVERY=true
#MQTT_DISCOVERY_PREFIX=homeassistant
