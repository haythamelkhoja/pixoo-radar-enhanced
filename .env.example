# Pixoo Radar settings. Copy to .env and edit. Full reference: docs/configuration.md

# --- Required ---------------------------------------------------------------
# IP or hostname of your Pixoo64 (find it in the Divoom app: Device settings > Wi-Fi)
PIXOO_HOST=192.168.1.50
# Your location in decimal degrees (right-click a spot in Google Maps to copy it)
HOME_LAT=51.4700
HOME_LON=-0.4543

# --- Recommended ------------------------------------------------------------
# Where the Pixoo can fetch animations from this app: plain http, this host's LAN
# IP or name, and the app's own port. Avoids the "Loading.." screen on every update.
# Leave empty to push frames instead.
GIF_BASE_URL=http://192.168.1.20:8765
# Timezone for log timestamps
TZ=Europe/London

# --- Optional (defaults shown; quote colours because of the #) ----------
#RADAR_RADIUS_KM=100
#REFRESH_SECONDS=60
#SHOW_GROUND_TRAFFIC=false
#FRAME_MS=300
#PIXOO_BRIGHTNESS=-1
#LOGO_SOURCES=fr24,avcodes
#COLOR_TEXT="#FFFF00"
#COLOR_BOX="#2B2B2B"
#GIF_PORT=8765
